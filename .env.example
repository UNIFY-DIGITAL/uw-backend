# The organisation. Everything else (Puter's config, Caddy, the apps, the chat
# server) is derived from these four by scripts/configure.sh and scripts/lib/suite.sh.
PUTER_DOMAIN=unifyworks.localhost   # web: <domain>, <app>.<domain> (any *.localhost name works locally)
PUTER_PROTOCOL=http                 # https on staging and production
MAIL_DOMAIN=unify.works             # addresses: <username>@<MAIL_DOMAIN>
#TLS_MODE=off                       # off (http) | files (your wildcard cert in puter/tls/) | auto (Caddy fetches its own)
BRAND_NAME="Unify Works"
# What kind of server: organisation (people are added by an administrator; no
# sign-up, no guests) or trial (public: anyone signs up with email or Google, or
# tries the apps as a temporary guest; mail only between its own accounts).
SUITE_MODE=organisation             # organisation | trial
#TRIAL_CHAT=1                       # trial: sign-ups join the one Chat workspace (they see each other)

# Mail the server sends: sign-up codes (needed for email sign-up), password
# resets, and on an organisation server people's mail to outside addresses.
# Unset: config.json's transport as it is (MailHog: nothing leaves the server).
# Google Cloud blocks port 25 out: use 587.
#SMTP_RELAY_HOST=smtp-relay.gmail.com
#SMTP_RELAY_PORT=587
#SMTP_RELAY_USER=CHANGE_ME
#SMTP_RELAY_PASSWORD=CHANGE_ME

# Sign in with Google: an OAuth client (Web application) whose redirect URIs are
# <protocol>://<domain>/auth/oidc/callback/login, /signup and /revalidate.
# Unset: no Google button. Sign-up through it only where sign-up is on (trial).
#GOOGLE_CLIENT_ID=CHANGE_ME
#GOOGLE_CLIENT_SECRET=CHANGE_ME

# Sources the scripts read: git first, then a local folder, then a fallback.
#   The apps (scripts/deploy-apps.sh): FRONTEND_GIT_URL, else EVERYTHING (a local
#   checkout of uw-frontend's src/), else the apps already deployed are kept.
#FRONTEND_GIT_URL=https://github.com/UNIFY-DIGITAL/uw-frontend.git
#FRONTEND_GIT_REF=self-hosted
#EVERYTHING=~/everything/src
#   The logos (scripts/sync-brand.sh): BRAND_GIT_URL (BRAND_GIT_PATH in it), else
#   BRAND_SOURCE (a URL or a local folder), else the suite's own in apps/brand/.
#BRAND_GIT_URL=https://github.com/UNIFY-DIGITAL/uw-frontend-web.git
#BRAND_GIT_REF=feature/unify-works-site   # main once merged
#BRAND_GIT_PATH=public/brand
#BRAND_SOURCE=https://<firebase site>/brand

# Where images come from. Leave unset on a developer's machine: Docker Hub and
# GitHub's registry, public. Staging and production set it to our Artifact
# Registry (see .env.production.example); the images are the same, by digest.
#REGISTRY=asia-south1-docker.pkg.dev/unifyworks/unify-suite

# Where Puter's source comes from (scripts/build-desktop.sh, upgrade-puter.sh).
# Unset = HeyPuter's GitHub. Servers use our private mirror, so builds never
# depend on HeyPuter staying public.
#PUTER_GIT_URL=https://github.com/UNIFY-DIGITAL/puter-mirror.git

HTTP_PORT=80
MARIADB_ROOT_PASSWORD=CHANGE_ME  # openssl rand -hex 32
MARIADB_DATABASE=puter
MARIADB_USER=puter
MARIADB_PASSWORD=CHANGE_ME  # openssl rand -hex 32
S3_ACCESS_KEY=CHANGE_ME  # openssl rand -hex 32
S3_SECRET_KEY=CHANGE_ME  # openssl rand -hex 32
S3_BUCKET=puter-local
SMTP_PORT=2525

# Demo servers: a known password for the bootstrap administrator "admin"
# (scripts/seed-admin.sh). Unset: Puter's random one, printed once in its log.
# Anyone who guesses it runs the server: never a guessable one on a real one.
#ADMIN_PASSWORD=CHANGE_ME

# Chat server (chat-server/): the service account that holds all chat data.
CHAT_SERVICE_USER=unifychat
CHAT_SERVICE_PASSWORD=CHANGE_ME  # openssl rand -hex 32
CHAT_ORG_NAME="Unify Works"
# Admins of that workspace (see its invite link, invite guests to a channel) besides the
# suite's administrators: usernames, comma-separated. Organisation servers; on a trial
# server everyone may create a workspace of their own and invite to it.
CHAT_ADMINS=
# Shared with config.json "unifyInternal.secret": lets the chat server mail colleagues on a user's behalf.
UNIFY_INTERNAL_SECRET=CHANGE_ME  # openssl rand -hex 32

# Calls (huddles, Meetings): our own TURN/STUN relay (coturn) and signaller.
# The chat server mints short-lived relay logins from this secret.
TURN_SECRET=CHANGE_ME  # openssl rand -hex 32
# Address browsers reach coturn at, and the IP coturn advertises for relays.
# Local: 127.0.0.1. Staging: the server's public (or LAN) IP / DNS name.
#TURN_HOST=127.0.0.1
#TURN_EXTERNAL_IP=127.0.0.1
# Local only: relays between two browsers on this same machine.
#TURN_ALLOW_LOOPBACK=true


