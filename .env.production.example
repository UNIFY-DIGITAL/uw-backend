# Staging / production settings. On the server: cp .env.production.example .env,
# fill every CHANGE_ME (openssl rand -hex 32), chmod 600 .env. Never commit .env.
#
# The organisation. Everything else (Puter's config, Caddy, the apps, the chat
# server) is derived from these four by scripts/configure.sh and scripts/lib/suite.sh.
PUTER_DOMAIN=CHANGE_ME             # web: <domain>, <app>.<domain>; DNS: <domain> and *.<domain> -> the server
PUTER_PROTOCOL=https
MAIL_DOMAIN=unify.works             # addresses: <username>@<MAIL_DOMAIN>
TLS_MODE=auto                       # auto: Caddy fetches certificates itself (ports 80+443 open) | files: your wildcard cert in puter/tls/
BRAND_NAME="Unify Works"

# Where images come from. Leave unset on a developer's machine: Docker Hub and
# GitHub's registry, public. Staging and production set it to our Artifact
# Registry (see .env.production.example); the images are the same, by digest.
REGISTRY=asia-south1-docker.pkg.dev/unifyworks/unify-suite   # the VM's service account: Artifact Registry Reader

HTTP_PORT=80
MARIADB_ROOT_PASSWORD=CHANGE_ME  # openssl rand -hex 32
MARIADB_DATABASE=puter
MARIADB_USER=puter
MARIADB_PASSWORD=CHANGE_ME  # openssl rand -hex 32
S3_ACCESS_KEY=CHANGE_ME  # openssl rand -hex 32
S3_SECRET_KEY=CHANGE_ME  # openssl rand -hex 32
S3_BUCKET=puter-local
SMTP_PORT=2525

# Chat server (chat-server/): the service account that holds all chat data.
CHAT_SERVICE_USER=unifychat
CHAT_SERVICE_PASSWORD=CHANGE_ME  # openssl rand -hex 32
CHAT_ORG_NAME="Unify Works"
# Shared with config.json "unifyInternal.secret": lets the chat server mail colleagues on a user's behalf.
UNIFY_INTERNAL_SECRET=CHANGE_ME  # openssl rand -hex 32

# Calls (huddles, Meetings): our own TURN/STUN relay (coturn) and signaller.
# The chat server mints short-lived relay logins from this secret.
TURN_SECRET=CHANGE_ME  # openssl rand -hex 32
# Address browsers reach coturn at, and the IP coturn advertises for relays.
# Local: 127.0.0.1. Staging: the server's public (or LAN) IP / DNS name.
TURN_HOST=CHANGE_ME          # the server's public IP or DNS name
TURN_EXTERNAL_IP=CHANGE_ME   # the server's public IP
TURN_BIND=0.0.0.0           # plus firewall rules: 3478 tcp/udp, 49160-49200/udp
